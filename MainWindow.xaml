<Window x:Class="kisauto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kisauto"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="bt_start" Content="Start" Width="90" Height="45" Grid.Row="1" Click="bt_start_Click_1" />
        <Canvas x:Name="pálya" Grid.Row="3" Background="AliceBlue" >
            <Button x:Name="pinimobil" Content="Pinimobil" Width="90" Height="45" Background="#FF00E418"
                Canvas.Left="20" Canvas.Top="50" />
            <Button x:Name="Ferrari" Content="Ferrari" Width="90" Height="45" Background="Red"
                Canvas.Left="20" Canvas.Top="120" />
            <Button x:Name="Ford" Content="Ford" Width="90" Height="45" Background="Blue"
                Canvas.Left="20" Canvas.Top="190" />
            <Canvas Height="334" Width="800">
                <TextBox TextWrapping="Wrap" Text="TextBox" Width="5" HorizontalAlignment="Center" Canvas.Left="650" VerticalAlignment="Top"  Height="500" Background="DarkRed"/>
            </Canvas>
        </Canvas>
    </Grid>
</Window>
